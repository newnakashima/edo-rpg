# 通常戦闘: 速い三味線と太鼓
# 設計: テンポ 168、D の民謡音階（D F G A C）の旋律に D 短調のコードを付ける
# 形式: I（4 小節、太鼓と三味線の刻みで幕開け）+ A A2 B B2（各 8 小節、ループ部分 32 小節 = 45.7 秒）
# 編成（同時 8 音）: 三味線の旋律 / 金管 6 度下の重ね（A2・B2）と箏の 16 分の分散和音（A・B）を区間ごとに入れ替え /
#       弦の刻み 2 音 / ピックベース / ドラムキット + 大太鼓・締太鼓（2 音まで。区間の頭はクラッシュ + 大太鼓）
title = 通常戦闘
id    = bgm_battle
tempo = 168
meter = 4/4
key   = D minyo
intro = I
form  = A A2 B B2
echo  = 112 0.25 0.18

[parts]
# 名前   楽器      種類                 オプション
melody   shamisen  notes                vol=122 pan=0
double   brass     notes                follow=melody shift=-6d vol=98 pan=-26
motion   koto      arp:up16             oct=4 vol=70 pan=30
pad      strings   block:push8          oct=4 voices=2 vol=68 pan=-36
bass     pickbass  bass:drive8          oct=2 vol=100
drums    drums     drums                vol=86

# 区間 I（4 小節）: 低い三味線の刻みと太鼓で幕を開け、A7 で A の頭の Dm へ渡す
[section I]
chords  | Dm | C | Bb | A7 |
melody  | D4:1/2 D4:1/4 D4:1/4 A4:1/2 D4:1/2 F4:1/2 A4:1/2 D5:1/2 A4:1/2 | E4:1/2 G4:1/4 G4:1/4 C5:1/2 G4:1/2 C5:1/2 G4:1/2 E5:1/2 C5:1/2 | F4:1/2 F4:1/4 F4:1/4 Bb4:1/2 D5:1/2 F5:1/2 D5:1/2 F5:1/2 D5:1/2 | G4:1/2 G4:1/4 G4:1/4 A4:1/2 C#5:1/2 E5:1/2 G5:1/2 E5:1/2 A5:1/2 |
double  off
motion  off
pad     @block:stab
bass    @bass:root8
drums   | O . . O . . O . T t T t O . O . | O . . O . . O . T t T t O . O . | O . . O . . O . T t T t O . O . | O . O . M . M . T t T t S S S S |

# 区間 A（8 小節）: 主題。動機「タ・タタ・跳ね上がり」を Dm → C と 1 音ずつ下げてくり返す。
# 前半は A で半終止、後半は Bb C → Dm で終止
[section A]
chords  | Dm | C | Bb | A | Dm | C | Bb C | Dm |
