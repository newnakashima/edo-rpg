# 書式と手順の見本。街道を行く軽快な三味線の曲（A の民謡音階 A C D E G の旋律に、短調のコードを付ける）
title = 見本: 街道
id    = bgm_example
tempo = 138
meter = 4/4
key   = A minyo
form  = A B
echo  = 96 0.30 0.20

[parts]
# 名前   楽器      種類              オプション
melody   shamisen  notes             vol=110 pan=-10
harmony  koto      arp:up8           oct=4 vol=72 pan=30
bass     bass      bass:root-fifth   oct=2 vol=96
drums    drums     drums             vol=88

# 区間 A（8 小節）: 前半 4 小節で問い（E7 で半終止）、後半 4 小節で答え（Am で終止）
[section A]
chords  | Am | G | F | E7 | Am | G | F G | Am |
melody  | A4:1/2 C5 D5:1 E5:1 D5:1/2 C5 | D5:3/2 C5:1/2 D5:1 G5:1 | A5:1 G5:1/2 E5:1/2 F5:1 C5:1 | E5:1 D5:1/2 C5:1/2 B4:2 |
melody  | A4:1/2 C5 D5:1 E5:1 G5:1/2 E5:1/2 | D5:1 G5:1 D5:1/2 E5:1/2 D5:1 | A4:1 C5:1 B4:1 D5:1 | E5:1/2 D5:1/2 C5:1/2 B4:1/2 A4:2 |
drums   | O . t t O . t . | O . t t O . t . | O . t t O . t . | O . t t O t T T |
drums   | O . t t O . t . | O . t t O . t . | O . t t O . t . | O+K . t t O . . . |

# 区間 B（8 小節）: 音域を上げて盛り上げ、最後の E7 で A の頭へ戻す
[section B]
chords  | Dm | Am | Dm | E | F | G | Am | E7 |
melody  | D5:1 F5:1 A5:1 G5:1/2 F5:1/2 | E5:3/2 C5:1/2 E5:1 A5:1 | F5:1 A5:1/2 G5:1/2 F5:1 E5:1/2 D5:1/2 | E5:2 r:1 B4:1 |
melody  | C5:1 F5:1 A5:1 G5:1/2 F5:1/2 | G5:1 D5:1 B4:1 D5:1 | C5:1/2 D5:1/2 E5:1 A5:2 | B5:1 A5:1/2 G#5:1/2 E5:2 |
harmony @arp:updown8
drums   = A
